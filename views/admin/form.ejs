<%- include('partials/top', { pageTitle: (item ? 'Edit ' : 'Add ') + cfg.singular }) %>

<% const action = item ? `/admin/${slug}/${item._id}` : `/admin/${slug}`; %>

<main class="container admin-main">
  <a class="text-link" href="/admin/<%= slug %>">&larr; Back to <%= cfg.plural.toLowerCase() %></a>
  <h1 class="admin-title" style="margin-top: 10px"><%= item ? 'Edit' : 'Add' %> <%= cfg.singular.toLowerCase() %></h1>

  <form class="form-card admin-form wide" method="POST" action="<%= action %>" enctype="multipart/form-data">
    <% if (error) { %>
      <p class="alert err" role="alert"><%= error %></p>
    <% } %>

    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <% cfg.fields.forEach((f) => { const val = values[f.name] !== undefined ? values[f.name] : ''; %>
      <div class="field">
        <label for="f_<%= f.name %>"><%= f.label %><% if (f.required) { %> *<% } %></label>

        <% if (f.type === 'textarea') { %>
          <textarea id="f_<%= f.name %>" name="<%= f.name %>" maxlength="<%= f.max || 1000 %>" <%= f.required ? 'required' : '' %>><%= val %></textarea>

        <% } else if (f.type === 'image') { %>
          <% if (val) { %><img class="preview" src="<%= val %>" alt="Current image"><% } %>
          <input id="f_<%= f.name %>" name="<%= f.name %>" type="text" value="<%= val %>" placeholder="Image link, or upload a file below">
          <input name="imageFile" type="file" accept="image/png,image/jpeg,image/webp,image/gif" aria-label="Upload an image file">

        <% } else if (f.type === 'number') { %>
          <input id="f_<%= f.name %>" name="<%= f.name %>" type="number" step="1" min="-9999" max="9999" value="<%= val %>">

        <% } else if (f.type === 'url') { %>
          <input id="f_<%= f.name %>" name="<%= f.name %>" type="url" maxlength="500" value="<%= val %>" placeholder="https://" <%= f.required ? 'required' : '' %>>

        <% } else { %>
          <input id="f_<%= f.name %>" name="<%= f.name %>" type="text" maxlength="<%= f.max || 120 %>" value="<%= val %>" <%= f.required ? 'required' : '' %>>
        <% } %>

        <% if (f.help) { %><small class="help"><%= f.help %></small><% } %>
      </div>
    <% }) %>

    <div class="form-actions">
      <button type="submit" class="btn">Save</button>
      <a href="/admin/<%= slug %>" class="btn btn-outline">Cancel</a>
    </div>
  </form>
</main>

<%- include('partials/bottom') %>